DECLARE PLUGIN "coq-completion.plugin"

{
open Ltac_plugin
open Stdarg
}

VERNAC COMMAND EXTEND Complete CLASSIFIED AS QUERY
| [ "Interreduce" ident(name) ":=" constr(e) "by" ident(a) "using" ident_list(rs)] -> {
    let rs = List.map Names.Id.to_string rs in
    let a = Names.Id.to_string a in
    let rewriters = List.map Libnames.qualid_of_string rs in
    let applier = Libnames.qualid_of_string a in
    let () = Coq_intf.prove_interreduce ~name ~goal:e ~rewriters ~applier in
    Feedback.msg_notice @@ Pp.str "P"
}
| [ "Complete" reference_list(axioms) ":" reference_list(ops) ":" ident(hint) ] -> {
  let hint_db_name = Names.Id.to_string hint in
  let _ = Main.complete axioms hint_db_name ops in
  Feedback.msg_notice @@ Pp.str "Finish"
}
| [ "Complete" "Record" reference(record) ":" ident(hint) ] -> {
  let hint_db_name = Names.Id.to_string hint in
  let _ = Main.complete_record record hint_db_name in
  Feedback.msg_notice @@ Pp.str "Finish"
}
| [ "Complete" reference_list(axioms) ":" reference_list(ops) ":" ident(hint) "for" constr(e) ] -> {
  let hint_db_name = Names.Id.to_string hint in
  let _ = Main.complete_for e axioms hint_db_name ops in
  Feedback.msg_notice @@ Pp.str "Finish"
}
END

VERNAC COMMAND EXTEND ShowRecord CLASSIFIED AS QUERY
| [ "Show" "Record" reference(r) ] -> {
  let env = Global.env () in
  let sigma = Evd.from_env env in
  Record_ext.show_record env sigma r
}
END

TACTIC EXTEND print_term
| [ "print_term" constr(e) ] -> {
  Main.print_term e
}
END

TACTIC EXTEND complete
| [ "complete" preident_list(axioms) ":" preident_list(constants) clause(cl) ] -> {
  Main.complete_in_tac axioms constants cl
}
END

TACTIC EXTEND lpo_rewrite
| [ "lpo_autorewrite" "with" preident(hint) clause(cl) ] -> {
  Main.lpo_autorewrite_with hint cl
}
END

TACTIC EXTEND compl_auto
| [ "compl_auto" preident_list(fixpoints) ] -> {
  Main.compl_auto fixpoints
}
END

{
open Locus
open Extraargs

let wit_glob_constr_with_bindings = G_rewrite.wit_glob_constr_with_bindings
let cl_rewrite_clause (ist, c) b occ cl =
  let c env sigma = Tacinterp.interp_open_constr_with_bindings ist env sigma c in
  Rewrite_pos.cl_rewrite_clause c b occ cl

let rewrite_pos (ist, c) b occ cl poss =
  let c env sigma = Tacinterp.interp_open_constr_with_bindings ist env sigma c in
  Rewrite_pos.rewrite_pos c b occ cl poss
}

TACTIC EXTEND my_setoid_rewrite
 | [ "my_setoid_rewrite" orient(o) glob_constr_with_bindings(c) ]
   -> { cl_rewrite_clause c o AllOccurrences None }
END

TACTIC EXTEND rewrite_pos
 | [ "rewrite_pos" orient(o) glob_constr_with_bindings(c) "at" ne_nat_list(poss) ]
   -> { rewrite_pos c o (OnlyOccurrences([1])) None poss }
 | [ "rewrite_pos" "lhs" orient(o) glob_constr_with_bindings(c) "at" ne_nat_list(poss) ]
   -> { rewrite_pos c o (OnlyOccurrences([1])) None (1 :: poss) }
 | [ "rewrite_pos" "rhs" orient(o) glob_constr_with_bindings(c) "at" ne_nat_list(poss) ]
   -> { rewrite_pos c o (OnlyOccurrences([1])) None (2 :: poss) }

 | [ "rewrite_pos" orient(o) glob_constr_with_bindings(c) ]
   -> { rewrite_pos c o (OnlyOccurrences([1])) None [] }
 | [ "rewrite_pos" "lhs" orient(o) glob_constr_with_bindings(c) ]
   -> { rewrite_pos c o (OnlyOccurrences([1])) None [1] }
 | [ "rewrite_pos" "rhs" orient(o) glob_constr_with_bindings(c) ]
   -> { rewrite_pos c o (OnlyOccurrences([1])) None [2] }

 | [ "rewrite_pos" orient(o) glob_constr_with_bindings(c) "at" ne_nat_list(poss) "in" hyp(id) ]
   -> { rewrite_pos c o (OnlyOccurrences([1])) (Some id) poss }
 | [ "rewrite_pos" "lhs" orient(o) glob_constr_with_bindings(c) "at" ne_nat_list(poss) "in" hyp(id) ]
   -> { rewrite_pos c o (OnlyOccurrences([1])) (Some id) (1 :: poss) }
 | [ "rewrite_pos" "rhs" orient(o) glob_constr_with_bindings(c) "at" ne_nat_list(poss) "in" hyp(id) ]
   -> { rewrite_pos c o (OnlyOccurrences([1])) (Some id) (2 :: poss) }

 | [ "rewrite_pos" orient(o) glob_constr_with_bindings(c) "in" hyp(id) ]
   -> { rewrite_pos c o (OnlyOccurrences([1])) (Some id) [] }
 | [ "rewrite_pos" "lhs" orient(o) glob_constr_with_bindings(c) "in" hyp(id) ]
   -> { rewrite_pos c o (OnlyOccurrences([1])) (Some id) [1] }
 | [ "rewrite_pos" "rhs" orient(o) glob_constr_with_bindings(c) "in" hyp(id) ]
   -> { rewrite_pos c o (OnlyOccurrences([1])) (Some id) [2] }
END

